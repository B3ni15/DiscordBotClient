# Optional: accounts and cross-device sync.
#
# With none of this set the app runs exactly as it always has — bot token, DMs
# and settings live in the browser only, and the sign-in screen offers nothing
# else. Fill it in to offer "Sign in with Discord" and an encrypted vault.

# --- Cloudflare D1 (the database) -------------------------------------------
# Dashboard → Workers & Pages → D1 → your database. The API token needs the
# "D1 Edit" permission for the account that owns the database.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Local development instead of D1: the same schema on a SQLite file.
#   npm run db:local     # creates/updates prisma/dev.db
# DATABASE_URL=file:./prisma/dev.db

# --- Discord OAuth app (who you are) ----------------------------------------
# Developer Portal → your application → OAuth2. Add the redirect below to the
# app's redirect list. Only the `identify` scope is ever requested.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Defaults to <origin>/api/auth/callback, which is right for most deployments.
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Voice bridge (live microphone, file playback and listening) ------------
# The deployment hosts the voice worker at /api/voice/bridge, and by default
# only pages from this same deployment may use it. List other origins here,
# comma separated, or "*" to allow any.
# VOICE_BRIDGE_ALLOWED_ORIGINS=

# --- Docker Compose (self-hosting) ------------------------------------------
# Used by docker-compose.yml; the app ignores these.
#
# Absolute path of this repository on the host. The updater container mounts it
# at the same path so it can run `docker compose` against the same files.
HOST_PROJECT_DIR=/opt/discordbotclient
# Branch the updater fast-forwards and redeploys. Defaults to the checked-out
# branch when empty.
GIT_BRANCH=master
# Seconds between git checks (300 = five minutes).
UPDATE_INTERVAL=300
# Host ports: the app and the voice bridge.
APP_PORT=6766
BRIDGE_HOST_PORT=6768
# Secret the voice bridge requires. Leave empty to generate a new one on every
# start and read it from the bridge logs.
BRIDGE_SECRET=
