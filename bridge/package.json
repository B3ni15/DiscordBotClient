{
  "name": "disbotclient-voice-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local voice worker for DisbotClient: holds the Discord voice connection a browser cannot open.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
