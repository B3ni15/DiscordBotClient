    "test:browser": "node test/browser-to-bridge.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.1.1",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  }
}
